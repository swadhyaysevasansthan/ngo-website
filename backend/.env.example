# SSF Backend Environment Variables Template

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Authentication Secrets
JWT_SECRET=your_admin_jwt_secret_here
JWT_JUDGE_SECRET=your_judge_jwt_secret_here
QR_PASS_JWT_SECRET=your_scanner_jwt_secret_here

# Third-Party Integrations
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Service
RESEND_API_KEY=re_yourresendkeyhere
SNEAC_RESEND_API_KEY=re_yoursneacresendkeyhere
EMAIL_FROM=noreply@swadhyayseva.org
SNEAC_EMAIL_FROM=sneac@swadhyayseva.org
